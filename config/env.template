# SYNTHNET settings. Restart the app after editing. (Prices/till/branding live in portal.json and apply instantly.)
PORT=80
HOTSPOT_IP=192.168.137.1
ADMIN_TOKEN=change-me-please
VOUCHER_BACKEND=local

# Hotspot identity + behaviour
HOTSPOT_SSID=SYNTHNET_VOUCHER_HOTSPOT
HOTSPOT_PASSWORD=12345678
AUTO_START_HOTSPOT=true
STOP_HOTSPOT_ON_EXIT=true

# Internet gate: unpaid devices see ONLY the portal (needs Administrator).
# GATE_REQUIRED=true -> if the gate is not active the hotspot is NOT started / is stopped (no free-internet leaks).
GATE_ENABLED=true
GATE_REQUIRED=true

# /admin is reachable only from this laptop
ADMIN_LOCAL_ONLY=true

# Courtney Tech M-Pesa STK Push (https://courtneytech.xyz/dev-docs)
COURTNEYTECH_API_KEY=
COURTNEYTECH_API_SECRET=
# payment_account_id (a number): dashboard > "Test Courtney Tech connection" lists it
COURTNEYTECH_ACCOUNT_ID=
COURTNEYTECH_BASE_URL=https://courtneytech.xyz/api
# Optional instant webhooks: public https URL of a tunnel to this laptop. Blank = polling only (works with no tunnel)
COURTNEYTECH_PUBLIC_URL=

# Only for lab testing: creates TEST-1HOUR / TEST-1DAY free vouchers on a NEW install
SEED_TEST_VOUCHERS=false

# Olympus SMS (https://sms.ots.co.ke): customer messages. Easier: Admin dashboard > SMS messaging > Connection (no restart needed).
# Token: Olympus dashboard > Developers > Reveal token. Sender ID: your approved sender ID (max 11 characters).
OLYMPUS_SMS_TOKEN=
OLYMPUS_SMS_SENDER_ID=
OLYMPUS_SMS_BASE_URL=https://sms.ots.co.ke/api/v3
# Time zone used when writing times inside SMS ("today 6:45 PM")
SMS_TIMEZONE=Africa/Nairobi
